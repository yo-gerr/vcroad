rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // Helper functions
    // ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isUser() {
      return isAuthenticated() && getRole() == 'user';
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    function isSysAdmin() {
      return isAuthenticated() && getRole() == 'sysadmin';
    }

    function isAdminOrAbove() {
      return isAdmin() || isSysAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isNotBanned() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
    }

    function isVerifiedUser() {
      return isUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true;
    }

    // ──────────────────────────────────────────────
    // Users collection
    // ──────────────────────────────────────────────
    match /users/{userId} {
      // Own profile is readable by its owner; other profiles only by
      // admins/sysadmins (protects emails, phone numbers, addresses, ID paths).
      allow read: if isOwner(userId) || isAdminOrAbove();

      // Users can create their own doc with role 'user' only.
      // Sysadmins may create barangay-admin accounts (role 'admin').
      allow create: if (isOwner(userId)
            && request.resource.data.role == 'user')
        || (isSysAdmin() && request.resource.data.role == 'admin');

      // Owners may update only non-privileged profile fields (a diff against
      // the existing doc). Changing role / ban / verification / deletion state
      // requires an admin/sysadmin, preventing privilege escalation.
      // Sysadmins can manage all.
      allow update: if (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'firstName', 'middleName', 'lastName', 'suffix',
                 'phoneNumber', 'street', 'houseNumber', 'barangay',
                 'selfiePath', 'updatedAt', 'lastLoginAt', 'unbanRequestAt',
                 'scheduledForDeletionAt', 'deletedAt',
                 'learningStats', 'lastActivityAt', 'badges',
                 'learningStats.completedLessons',
                 'learningStats.totalPointsEarned',
                 'learningStats.totalPointsAvailable',
                 'learningStats.lastActivityDate',
                 'learningStats.xp',
                 'learningStats.level',
                 'learningStats.currentStreak',
                 'learningStats.longestStreak',
               ]))
        || (isAdmin()
          && get(/databases/$(database)/documents/users/$(userId)).data.role == 'user')
        || isSysAdmin();

      // Only sysadmins can delete user documents
      allow delete: if isSysAdmin();
    }

    // ──────────────────────────────────────────────
    // Reports collection
    // ──────────────────────────────────────────────
    match /reports/{reportId} {
      // Any authenticated user can read reports
      allow read: if isAuthenticated();

      // Only verified, non-banned users can create reports
      allow create: if isVerifiedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reportedBy == request.auth.uid;

      // Report owner can update; admin/sysadmin can manage any
      allow update: if isOwner(request.resource.data.userId)
        || isAdminOrAbove();

      // Admin/sysadmin can delete reports
      allow delete: if isAdminOrAbove();
    }

    // ──────────────────────────────────────────────
    // Advisories collection
    // ──────────────────────────────────────────────
    match /advisories/{advisoryId} {
      // Any authenticated user can read
      allow read: if isAuthenticated();

      // Only admins and sysadmins can create advisories. The creator uid must
      // match the authenticated user (identity-verifiable audit field), and a
      // barangay admin is restricted to their own barangay (a null admin
      // barangay is allowed through to avoid locking out unassigned admins).
      allow create: if isSysAdmin()
        || (isAdmin()
          && request.auth.uid == request.resource.data.createdByUid
          && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barangay == null
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.barangay
                  == request.resource.data.barangay));

      // Only admin and sysadmin can update. Optimistic-lock version must
      // increment by exactly 1, status must be one of the known values, and
      // identity/audit fields are immutable after creation.
      allow update: if isAdminOrAbove()
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.advisoryId == resource.data.advisoryId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.status in
            ['active', 'inactive', 'expired', 'scheduled'];

      // Only admin and sysadmin can delete
      allow delete: if isAdminOrAbove();
    }

    // ──────────────────────────────────────────────
    // Reactions (confirm/refute on reports)
    // ──────────────────────────────────────────────
    match /reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(request.resource.data.userId);
      allow delete: if isOwner(request.resource.data.userId);
    }

    // ──────────────────────────────────────────────
    // Comments on reports
    // ──────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(request.resource.data.userId)
        || isAdminOrAbove();
      allow delete: if isOwner(request.resource.data.userId)
        || isAdminOrAbove();
    }

    // ──────────────────────────────────────────────
    // Pending registrations
    // ──────────────────────────────────────────────
    match /pendingRegistrations/{uid} {
      // Only the registering user can read their own pending doc
      allow read: if isOwner(uid);

      // Anyone can create (unauthenticated registration flow)
      allow create: if true;

      // Only the owner can update
      allow update: if isOwner(uid);

      // Admin/sysadmin can delete (approve/reject pending)
      allow delete: if isAdminOrAbove() || isOwner(uid);
    }

    // ──────────────────────────────────────────────
    // Session data
    // ──────────────────────────────────────────────
    match /sessions/{uid} {
      // Only the session owner can read/write
      allow read, write: if isOwner(uid);
    }

    // ──────────────────────────────────────────────
    // Login attempt tracking
    // ──────────────────────────────────────────────
    match /loginAttempts/{email} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ──────────────────────────────────────────────
    // Lessons collection
    // ──────────────────────────────────────────────
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow create: if isSysAdmin();
      allow update: if isSysAdmin();
      allow delete: if isSysAdmin();
    }

    // ──────────────────────────────────────────────
    // Questions collection
    // ──────────────────────────────────────────────
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isSysAdmin();
      allow update: if isSysAdmin()
        || (isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['timesAnswered', 'timesCorrect']));
      allow delete: if isSysAdmin();
    }

    // ──────────────────────────────────────────────
    // Chapters collection
    // ──────────────────────────────────────────────
    match /chapters/{chapterId} {
      allow read: if isAuthenticated();
      allow write: if isSysAdmin();
    }

    // ──────────────────────────────────────────────
    // Lesson progress
    // ──────────────────────────────────────────────
    match /lesson_progress/{docId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
      allow delete: if false;
    }

    // ──────────────────────────────────────────────
    // User activity 
    // ──────────────────────────────────────────────
    match /userActivity/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    // ──────────────────────────────────────────────
    // Settings / config
    // ──────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrAbove();
    }

    // ──────────────────────────────────────────────
    // Default: deny all other access
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
